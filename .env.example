# Domain gốc của API phim (kiểu Ophim). Đổi lại nếu domain bị đổi/die.
VITE_API_BASE_URL=https://phimapi.com

# Mật khẩu tạm khoá site trong lúc test/dev (xem SiteGate.tsx). Để trống
# thì không khoá gì cả. LƯU Ý: đây là biến VITE_* nên bị nhúng thẳng vào
# bundle JS công khai — không phải cơ chế bảo mật thật, chỉ chặn khách
# vãng lai tình cờ.
VITE_SITE_PASSWORD=
